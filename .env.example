# --- Discord ---
DISCORD_TOKEN=
# Serveur sur lequel la commande /atm est enregistrée au démarrage du bot (instantané).
# Laisser vide pour un enregistrement global (peut prendre jusqu'à 1h).
DISCORD_GUILD_ID=

# --- Session ATM ---
# Salon dans lequel les annonces de session ATM sont publiées
ATM_CHANNEL_ID=
# (Optionnel) Rôle mentionné quand le bouton « Ping agents » est sur OUI. Vide = @everyone
ATM_PING_ROLE_ID=
# Rôle dont les membres sont proposés dans /superviseur
ATM_SUPERVISOR_ROLE_ID=
# (Optionnel) Rôles autorisés à gérer TOUTES les sessions via le bouton ⚙️ (séparés par des virgules)
# Le créateur d'une session et les membres ayant la permission "Gérer le serveur" peuvent toujours la gérer.
ATM_MANAGER_ROLE_IDS=
# Fuseau horaire utilisé pour interpréter la date saisie dans le modal
TIMEZONE=Europe/Paris

# --- MongoDB (mongoose) ---
MONGODB_URI=mongodb://127.0.0.1:27017/bobcat

# --- Cloudinary (photos des sessions) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bobcat/atm
